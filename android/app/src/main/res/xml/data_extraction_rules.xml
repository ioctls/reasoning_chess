<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep stats out of Google cloud backups. Moving to a new phone
     with a direct device-to-device transfer still carries them over. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
